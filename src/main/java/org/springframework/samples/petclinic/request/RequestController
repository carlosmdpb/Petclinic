package org.springframework.samples.petclinic.request;

import java.time.LocalDateTime;
import java.util.List;
import jakarta.validation.Valid;

import org.springframework.beans.BeanUtils;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.samples.petclinic.auth.payload.response.MessageResponse;
import org.springframework.samples.petclinic.clinicowner.ClinicOwner;
import org.springframework.samples.petclinic.clinicowner.ClinicOwnerService;
import org.springframework.samples.petclinic.exceptions.AccessDeniedException;
import org.springframework.samples.petclinic.exceptions.ResourceNotOwnedException;
import org.springframework.samples.petclinic.user.User;
import org.springframework.samples.petclinic.user.UserService;
import org.springframework.web.bind.annotation.DeleteMapping;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.ResponseStatus;
import org.springframework.web.bind.annotation.RestController;

import io.swagger.v3.oas.annotations.security.SecurityRequirement;

@RestController
@RequestMapping("/api/v1/requests")
@SecurityRequirement(name = "bearerAuth")
public class RequestController {

	private final RequestService requestService;
	private final ClinicOwnerService clinicOwnerService;
	private final UserService userService;
	private static final String ADMIN_AUTH = "ADMIN";
	private static final String CLINIC_OWNER_AUTH = "CLINIC_OWNER";

	@Autowired
	public RequestController(RequestService requestService, UserService userService, ClinicOwnerService clinicOwnerService) {
		this.requestService = requestService;
		this.userService = userService;
		this.clinicOwnerService = clinicOwnerService;
	}


	@GetMapping
	public ResponseEntity<List<Request>> findAllRequests() {

		User user = userService.findCurrentUser();

		List<Request> res = null;
		if (user.hasAnyAuthority(ADMIN_AUTH).equals(true)) {
			res = (List<Request>) requestService.findAll();
		} else if (user.hasAnyAuthority(CLINIC_OWNER_AUTH).equals(true)) {
			Integer clinicOwnerId = clinicOwnerService.findByUserId(user.getId()).getId();
			res = (List<Request>) requestService.findRequestsByClinicOwner(clinicOwnerId);
		}
		return new ResponseEntity<>(res, HttpStatus.OK);
	}

	@GetMapping(value = "{requestId}")
	public ResponseEntity<Request> findRequestById(@PathVariable("requestId") int id) {
		User user = userService.findCurrentUser();
		Request cons = this.requestService.findRequestById(id);
		if (user.hasAnyAuthority(ADMIN_AUTH, CLINIC_OWNER_AUTH).equals(true))
			return new ResponseEntity<>(cons, HttpStatus.OK);
		else
			throw new ResourceNotOwnedException(cons);
	}

	@GetMapping("/types")
	public ResponseEntity<List<RequestType>> findAllRequestTypes() {
		List<RequestType> res = requestService.findAllRequestTypes();
		return new ResponseEntity<>(res, HttpStatus.OK);
	}

	@GetMapping("/status")
	public ResponseEntity<List<RequestStatus>> findAllRequestStatus() {
		List<RequestStatus> res = requestService.findAllRequestStatus();
		return new ResponseEntity<>(res, HttpStatus.OK);
	}

	@PostMapping
	@ResponseStatus(HttpStatus.CREATED)
	public ResponseEntity<Request> createRequest(@RequestBody @Valid Request request) {
		User user = userService.findCurrentUser();
		Request newRequest = new Request();
		Request savedRequest;
		BeanUtils.copyProperties(request, newRequest, "id");
		if (user.hasAuthority(CLINIC_OWNER_AUTH).equals(true)) {
			ClinicOwner clinicOwner = userService.findClinicOwnerByUser(user.getId());
			newRequest.setClinicOwner(clinicOwner);
			newRequest.setStatus(RequestStatus.PENDING);
			newRequest.setCreationDate(LocalDateTime.now());
			savedRequest = this.requestService.saveRequest(newRequest);
			return new ResponseEntity<>(savedRequest, HttpStatus.CREATED);
		} else {
			throw new AccessDeniedException();
		}
	}

	@PutMapping(value = "{requestId}")
	@ResponseStatus(HttpStatus.OK)
	public ResponseEntity<Request> updateRequest(@PathVariable("requestId") int requestId,
			@RequestBody @Valid Request request) {
		Request aux = requestService.findRequestById(requestId);
		User user = userService.findCurrentUser();
		if (user.hasAuthority(CLINIC_OWNER_AUTH).equals(true)) {
			ClinicOwner owner = userService.findClinicOwnerByUser(user.getId());
			if (owner.getId().equals(aux.getClinicOwner().getId()) && !aux.getStatus().equals(RequestStatus.CLOSED)) {
				return new ResponseEntity<>(this.requestService.updateRequest(request, requestId), HttpStatus.OK);
			} else {
				throw new ResourceNotOwnedException(aux);
			}
		} else {
			throw new AccessDeniedException();
		}
	}

	@DeleteMapping(value = "{requestId}")
	@ResponseStatus(HttpStatus.OK)
	public ResponseEntity<MessageResponse> deleteRequest(@PathVariable("requestId") int requestId) {

		Request aux = requestService.findRequestById(requestId);
		User user = userService.findCurrentUser();

		if (user.hasAuthority(CLINIC_OWNER_AUTH).equals(true)) {
			ClinicOwner owner = userService.findClinicOwnerByUser(user.getId());
			if (owner.getId().equals(aux.getClinicOwner().getId()) && !aux.getStatus().equals(RequestStatus.CLOSED)) {
				requestService.deleteRequest(requestId);
				return new ResponseEntity<>(new MessageResponse("Request deleted!"), HttpStatus.OK);
			} else {
				throw new ResourceNotOwnedException(aux);
			}
		} else {
			throw new AccessDeniedException();
		}
	}

	@PutMapping(value = "/status/{requestId}")
	@ResponseStatus(HttpStatus.OK)
	public ResponseEntity<Request> updateStatusRequest(@PathVariable("requestId") int requestId,
			@RequestBody @Valid RequestStatus status) {

		Request aux = requestService.findRequestById(requestId);
		User user = userService.findCurrentUser();

		if (user.hasAuthority(ADMIN_AUTH).equals(true) && !aux.getStatus().equals(RequestStatus.CLOSED)) {
				aux.setStatus(status);
				return new ResponseEntity<>(this.requestService.updateRequest(aux, requestId), HttpStatus.OK);
		} else {
			throw new AccessDeniedException();
		}
	}

}